# Copy to .env.local for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables.
# With none of these set, local development runs in demo mode (sample data, demo logins).

# --- Google Sheets (Apps Script web app) -------------------------------------
# Deploy → Web app → URL ending in /exec
CLUB_API_URL=
# Same value as the PROPOSAL_SECRET Script Property in Apps Script (long random string)
CLUB_API_SECRET=

# --- Google sign-in (Google Cloud Console → Credentials → OAuth client ID, type "Web application") ---
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random characters; signs the session cookie
AUTH_SECRET=

# --- Web push (npx web-push generate-vapid-keys) --------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Scheduler ------------------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
# Put the same value in the Apps Script Script Property CRON_SECRET for the 15-minute trigger.
CRON_SECRET=

# --- Optional -------------------------------------------------------------------
# Public site URL for share previews (defaults to the Vercel production domain)
NEXT_PUBLIC_SITE_URL=
# "true" on a preview deployment to try everything with demo data before the sheet is ready
DEMO_MODE=
